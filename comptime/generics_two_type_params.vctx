// spec: §10 (Generics and specialization), §10.2 (Parameter kinds), §10.4 (Type generics)
// description: Comprehensive verification of components with multiple independent generic type parameters.
// rule: Component<Type A, Type B> allows independent specialization of input and output shapes.
// expect: pass

// A generic converter that casts from Type T_IN to Type T_OUT.
component Converter<Type T_IN, Type T_OUT>(
    in data_in: T_IN,
    out data_out: T_OUT
) {
    // Structural cast between generic types
    data_out := data_in as T_OUT
}

// A generic aggregator that combines two different types into a third type.
component Aggregator<Type T1, Type T2, Type T_RES>(
    in a: T1,
    in b: T2,
    out y: T_RES
) {
    // result = a + b (promoted/cast to T_RES)
    y := (a as T_RES) + (b as T_RES)
}

sim TestGenericsTwoTypeParams {
    // --- CASE 1: Widening & Signedness Flip (u8 -> s16) ---
    wire u8_val: u8 = 200
    wire s16_res: s16
    Converter<u8, s16>(data_in -- u8_val, data_out -- s16_res)
    
    assert(s16_res == 200 as s16, "u8(200) -> s16(200)")
    assert(width(s16_res) == 16, "Result width is 16")
    assert(is_signed(s16_res) == true, "Result is signed")

    // --- CASE 2: Mixed Standard Widths (u16 -> u32) ---
    wire u16_val: u16 = 0xCAFE
    wire u32_res: u32
    Converter<u16, u32>(u16_val, u32_res)
    assert(u32_res == 0x0000CAFE as u32, "u16 -> u32")

    // --- CASE 3: Boolean to Scalar (bool -> u8) ---
    wire b_val: bool = true
    wire u8_from_b: u8
    Converter<bool, u8>(b_val, u8_from_b)
    assert(u8_from_b == 1, "bool(T) -> u8(1)")

    // --- CASE 4: Three Type Params (Aggregator) ---
    // (u8, s8) -> s16
    wire a8: u8 = 100
    wire b8: s8 = -50
    wire res_s16: s16
    Aggregator<u8, s8, s16>(a8, b8, res_s16)
    assert(res_s16 == 50 as s16, "Aggregator: 100 + (-50) = 50")

    // --- CASE 5: Odd Widths (u3 -> s5) ---
    wire u3_val: u [ 3 ] = 7
    wire s5_res: s [ 5 ]
    Converter<u [ 3 ], s [ 5 ]>(u3_val, s5_res)
    assert(s5_res == 7 as s5, "u3(7) -> s5(7)")

    // --- CASE 6: Array Type Parameters ---
    // (u8[2] -> u16)
    // Note: vctx allows casting arrays to scalars if widths match (sum of elements).
    // u8[2] is 16 bits. u16 is 16 bits.
    wire u8_arr: u8 [ 2 ] = [0xAA, 0x55]
    wire u16_from_arr: u16
    Converter<u8 [ 2 ], u16>(u8_arr, u16_from_arr)
    assert(u16_from_arr == 0xAA55, "Array u8[2] -> u16 (Bit-accurate cast)")

    // --- CASE 7: Independence Verification ---
    // We instantiate two Different Converters with flipped types.
    wire u16_v: u16 = 1234
    wire u8_out: u8
    wire s32_out: s32
    
    // Inst 1: u16 -> u8 (Truncation)
    Converter<u16, u8>(u16_v, u8_out)
    // Inst 2: u16 -> s32 (Widening)
    Converter<u16, s32>(u16_v, s32_out)

    assert(u8_out == (1234 as u8), "u16(1234) truncated to u8")
    assert(s32_out == 1234 as s32, "u16(1234) widened to s32")
    assert(width(u8_out) == 8,  "Instance 1 width isolated")
    assert(width(s32_out) == 32, "Instance 2 width isolated")
}
