// spec: §10.4 (Type generics), §7.5 (Operator result rules)
// description: Comprehensive verification that signed and unsigned generic instantiations are isolated.
// rule: Component<u8> and Component<s8> are distinct types. Their type-dependent operations (like >>) must not conflate.
// expect: pass

// A generic component that performs a right shift by 1 on its generic input.
// The behavior of >> depends entirely on whether T is signed or unsigned.
component Shifter<Type T>(
    in d: T,
    out q: T
) {
    q := d >> 1
}

// Another component to check widening behavior (u8+u8 vs s8+s8)
component Adder<Type T>(
    in a: T,
    in b: T,
    out sum: T
) {
    // We cast back to T to truncate the promoted result
    sum := (a + b) as T
}

sim TestGenericSignedUnsignedPair {
    // --- 1. Shifter Instantiation ---
    // The bit pattern 1000_0000 (0x80)
    // In u8, it is 128. In s8, it is -128.
    wire input_u8: u8 = 128
    wire input_s8: s8 = -128
    
    wire out_u8: u8
    wire out_s8: s8

    Shifter<u8>(input_u8, out_u8)
    Shifter<s8>(input_s8, out_s8)

    // Verification
    // u8 >> 1 should zero-fill -> 0100_0000 (64)
    assert(out_u8 == 64, "Shifter<u8> performed logical right shift (Zero-fill)")
    assert(is_signed(out_u8) == false, "Output is unsigned")

    // s8 >> 1 should sign-fill -> 1100_0000 (-64)
    assert(out_s8 == -64, "Shifter<s8> performed arithmetic right shift (Sign-fill)")
    assert(is_signed(out_s8) == true, "Output is signed")

    // --- 2. Adder Instantiation (Overflow behavior) ---
    // u8 max is 255. 255 + 2 = 257 -> truncates to 1.
    // s8 max is 127. 127 + 2 = 129 -> truncates to -127.
    wire au8: u8 = 255
    wire bu8: u8 = 2
    wire su8: u8
    Adder<u8>(au8, bu8, su8)
    assert(su8 == 1, "Adder<u8>: 255 + 2 wraps to 1")

    wire as8: s8 = 127
    wire bs8: s8 = 2
    wire ss8: s8
    Adder<s8>(as8, bs8, ss8)
    assert(ss8 == -127, "Adder<s8>: 127 + 2 wraps to -127")

    // --- 3. Mixing within the same hierarchy ---
    // Let's pass the output of one generic directly into another to ensure port bindings 
    // strictly enforce the distinct types.
    wire cascade_u8: u8
    wire cascade_s8: s8
    
    Shifter<u8>(out_u8, cascade_u8) // 64 >> 1 = 32
    Shifter<s8>(out_s8, cascade_s8) // -64 >> 1 = -32

    assert(cascade_u8 == 32, "Cascade u8: 64 >> 1 = 32")
    assert(cascade_s8 == -32, "Cascade s8: -64 >> 1 = -32")

    // --- 4. Comparing the Bit Patterns ---
    // -64 is 0xC0. 64 is 0x40. 
    // Ensure that despite identical input bit patterns (0x80), the paths diverged.
    assert((out_u8 == (out_s8 as u8)) == false, "u8(64) != s8(-64) bit pattern")
}
