// spec: §5.6, §7.5, §18
// expect: pass
// Description: A compile-time Collatz Conjecture step counter using loops and if-else branches.

comptime collatz_steps(start_val: Int) -> Int {
    let n = start_val
    let steps = 0
    while n > 1 {
        if n % 2 == 0 {
            n = n / 2
        } else {
            n = 3 * n + 1
        }
        steps = steps + 1
    }
    return steps
}

component CollatzCarrier(out steps_for_12: u8, out steps_for_7: u8) {
    steps_for_12 := collatz_steps(12) as u8 // 9 steps
    steps_for_7 := collatz_steps(7) as u8   // 16 steps
}

sim TestCollatz {
    wire steps_for_12: u8
    wire steps_for_7: u8

    inst: CollatzCarrier(steps_for_12 -- steps_for_12, steps_for_7 -- steps_for_7)

    cycle()
    assert(steps_for_12 == 9, "Collatz(12) must take 9 steps")
    assert(steps_for_7 == 16, "Collatz(7) must take 16 steps")
}
