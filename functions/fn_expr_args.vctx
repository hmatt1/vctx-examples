// spec: §5.5, §7.3, §7.4
// description: Hardware functions called with complex expressions in argument position.
//   Exercises the inliner substitution path for non-trivial argument sites:
//   arithmetic, bitwise, shift, unary complement, comparison (bool arg), bit-slice,
//   ternary, all-args-expressions, and a compound expression containing a nested call.
// expect: pass

// ─── Receptors (simple functions chosen for easy verification) ────────────────

function bump_u8(x: u8) -> u8 {
    return (x + 1) as u8
}

function add_u8(a: u8, b: u8) -> u8 {
    return (a + b) as u8
}

// when-based body verifies that inlining an expression-arg into a function with
// internal control flow also works correctly.
function sel_u8(s: bool, a: u8, b: u8) -> u8 {
    wire r: u8
    when s {
        r := a
    } otherwise {
        r := b
    }
    return r
}

function in_range_u8(x: u8, lo: u8, hi: u8) -> bool {
    return (x >== lo) and (x <== hi)
}

// ─── A. Arithmetic expressions as arguments ───────────────────────────────────

component ArithInArgs(in a: u8, in b: u8, out sum_bump: u8, out diff_bump: u8, out both_arith: u8) {
    sum_bump   := bump_u8((a + b) as u8)                       // addition as arg
    diff_bump  := bump_u8((a - b) as u8)                       // subtraction as arg (wraps for a<b)
    both_arith := add_u8((a + b) as u8, (a - b) as u8)        // arithmetic in both arg slots
}

sim TestArithInArgs {
    wire a: u8 = 0
    wire b: u8 = 0
    wire sum_bump: u8
    wire diff_bump: u8
    wire both_arith: u8
    ArithInArgs(a, b, sum_bump, diff_bump, both_arith)

    // a=100, b=50: sum=150, diff=50
    poke(a, 100)
    poke(b, 50)
    cycle()
    assert(sum_bump   == 151 as u8, "bump(100+50)=151")
    assert(diff_bump  == 51 as u8,  "bump(100-50)=51")
    assert(both_arith == 200 as u8, "add(150,50)=200")

    // a=50, b=100: sum=150, diff=-50=206 as u8; add(150,206)=356%256=100
    poke(a, 50)
    poke(b, 100)
    cycle()
    assert(sum_bump   == 151 as u8, "bump(50+100)=151")
    assert(diff_bump  == 207 as u8, "bump(50-100 as u8)=207 (wraps: 206+1)")
    assert(both_arith == 100 as u8, "add(150,206 as u8)=356%256=100")
}

// ─── B. Bitwise expressions as arguments ─────────────────────────────────────

component BitwiseInArgs(in a: u8, in b: u8, in mask: u8,
                        out xor_b: u8, out and_b: u8, out not_b: u8, out bitwiseadd: u8) {
    xor_b     := bump_u8(a ^ b)                  // XOR as arg
    and_b     := bump_u8(a & mask)               // AND with mask as arg
    not_b     := bump_u8((~a) as u8)             // bitwise complement as arg
    bitwiseadd := add_u8(a ^ b, a & b)           // bitwise ops in both arg slots
}

sim TestBitwiseInArgs {
    wire a:    u8 = 0
    wire b:    u8 = 0
    wire mask: u8 = 0
    wire xor_b: u8
    wire and_b: u8
    wire not_b: u8
    wire bitwiseadd: u8
    BitwiseInArgs(a, b, mask, xor_b, and_b, not_b, bitwiseadd)

    // a=60 (0b00111100), b=45 (0b00101101), mask=240 (0b11110000)
    poke(a, 60)
    poke(b, 45)
    poke(mask, 240)
    cycle()
    // 60^45 = 0b00010001 = 17 → bump = 18
    assert(xor_b      == 18 as u8, "bump(60^45=17)=18")
    // 60&240 = 0b00110000 = 48 → bump = 49
    assert(and_b      == 49 as u8, "bump(60&240=48)=49")
    // ~60 = 0b11000011 = 195 → bump = 196
    assert(not_b      == 196 as u8, "bump(~60=195)=196")
    // 60^45=17, 60&45=0b00101100=44; add(17,44)=61
    assert(bitwiseadd == 61 as u8, "add(60^45=17, 60&45=44)=61")

    // Verify not_b at all-zeros: ~0=255 → bump=0 (wraps)
    poke(a, 0)
    cycle()
    assert(not_b == 0 as u8, "bump(~0=255)=256%256=0")

    // Verify xor_b at all-ones: 255^255=0 → bump=1
    poke(a, 255)
    poke(b, 255)
    cycle()
    assert(xor_b == 1 as u8, "bump(255^255=0)=1")
}

// ─── C. Shift expressions as arguments ───────────────────────────────────────

component ShiftInArgs(in a: u8, out lshift_bump: u8, out rshift_bump: u8) {
    lshift_bump := bump_u8((a << 2 as u8) as u8)    // left-shift expression as arg
    rshift_bump := bump_u8((a >> 1 as u8) as u8)    // right-shift expression as arg
}

sim TestShiftInArgs {
    wire a: u8 = 0
    wire lb: u8
    wire rb: u8
    ShiftInArgs(a, lb, rb)

    // a=5: 5<<2=20→bump=21; 5>>1=2→bump=3
    poke(a, 5)
    cycle()
    assert(lb == 21 as u8, "bump(5<<2=20)=21")
    assert(rb == 3 as u8,  "bump(5>>1=2)=3")

    // a=200: 200<<2 as u8: 800%256=32→bump=33; 200>>1=100→bump=101
    poke(a, 200)
    cycle()
    assert(lb == 33 as u8,  "bump(200<<2 as u8=32)=33")
    assert(rb == 101 as u8, "bump(200>>1=100)=101")

    // a=1: 1<<2=4→bump=5; 1>>1=0→bump=1
    poke(a, 1)
    cycle()
    assert(lb == 5 as u8, "bump(1<<2=4)=5")
    assert(rb == 1 as u8, "bump(1>>1=0)=1")
}

// ─── D. Bool-producing expressions as the boolean argument ───────────────────

component BoolExprInArgs(in a: u8, in b: u8, out cmp_sel: u8, out neq_sel: u8, out fn_sel: u8) {
    // Comparison produces the bool arg to a mux function
    cmp_sel := sel_u8(a > b, a, b)
    // Inequality bool arg + bitwise expressions in the value args
    neq_sel := sel_u8(a !== b, a ^ b, a & b)
    // A function call IS the bool arg (composed function call at arg site)
    fn_sel  := sel_u8(in_range_u8(a, 10 as u8, 50 as u8), a, b)
}

sim TestBoolExprInArgs {
    wire a: u8 = 0
    wire b: u8 = 0
    wire cmp_sel: u8
    wire neq_sel: u8
    wire fn_sel:  u8
    BoolExprInArgs(a, b, cmp_sel, neq_sel, fn_sel)

    // a=20, b=30: 20>30=false→b=30; 20!==30=true→20^30=10; in_range(20,10,50)=true→a=20
    poke(a, 20)
    poke(b, 30)
    cycle()
    assert(cmp_sel == 30 as u8, "a=20<b=30: sel picks b=30")
    assert(neq_sel == 10 as u8, "a!==b, 20^30=10")
    assert(fn_sel  == 20 as u8, "20 in [10,50]: sel picks a=20")

    // a=10, b=5: 10>5=true→a=10; 10!==5=true→10^5=15; in_range(10,10,50)=true→a=10 (boundary)
    poke(a, 10)
    poke(b, 5)
    cycle()
    assert(cmp_sel == 10 as u8, "a=10>b=5: sel picks a=10")
    assert(neq_sel == 15 as u8, "a!==b, 10^5=15")
    assert(fn_sel  == 10 as u8, "10 in [10,50] (boundary): sel picks a=10")

    // a=5, b=10: 5>10=false→b=10; 5!==10=true→5^10=15; in_range(5,10,50)=false→b=10
    poke(a, 5)
    poke(b, 10)
    cycle()
    assert(cmp_sel == 10 as u8, "a=5<b=10: sel picks b=10")
    assert(neq_sel == 15 as u8, "a!==b, 5^10=15")
    assert(fn_sel  == 10 as u8, "5 not in [10,50]: sel picks b=10")

    // a=b=42: cmp false→b; neq false→a&b=42; in_range true→a=42
    poke(a, 42)
    poke(b, 42)
    cycle()
    assert(cmp_sel == 42 as u8, "a==b: cmp false, picks b=42")
    assert(neq_sel == 42 as u8, "a==b: neq false, picks a&b=42")
    assert(fn_sel  == 42 as u8, "42 in [10,50]: picks a=42")
}

// ─── E. Bit-slice expressions as arguments ────────────────────────────────────

component SliceInArgs(in x: u8, out lo_nibble_bump: u8, out hi_nibble_bump: u8) {
    lo_nibble_bump := bump_u8(x[3..0] as u8)    // lower 4 bits, zero-extended, then bump
    hi_nibble_bump := bump_u8(x[7..4] as u8)    // upper 4 bits, zero-extended, then bump
}

sim TestSliceInArgs {
    wire x: u8 = 0
    wire lo: u8
    wire hi: u8
    SliceInArgs(x, lo, hi)

    // x=0xAB=10101011: lo=0b1011=11→bump=12; hi=0b1010=10→bump=11
    poke(x, 0xAB)
    cycle()
    assert(lo == 12 as u8, "0xAB[3..0]=11→bump=12")
    assert(hi == 11 as u8, "0xAB[7..4]=10→bump=11")

    // x=0x3C=00111100: lo=0b1100=12→bump=13; hi=0b0011=3→bump=4
    poke(x, 0x3C)
    cycle()
    assert(lo == 13 as u8, "0x3C[3..0]=12→bump=13")
    assert(hi == 4 as u8,  "0x3C[7..4]=3→bump=4")

    // x=0xFF: both nibbles=15→bump=16
    poke(x, 0xFF)
    cycle()
    assert(lo == 16 as u8, "0xFF[3..0]=15→bump=16")
    assert(hi == 16 as u8, "0xFF[7..4]=15→bump=16")

    // x=0x00: both nibbles=0→bump=1
    poke(x, 0x00)
    cycle()
    assert(lo == 1 as u8, "0x00[3..0]=0→bump=1")
    assert(hi == 1 as u8, "0x00[7..4]=0→bump=1")
}

// ─── F. Every argument is a non-trivial expression ────────────────────────────

// in_range_u8(x, lo, hi) where all three are computed from ports.
component AllExprArgs(in a: u8, in b: u8, in mask: u8, out in_band: bool) {
    in_band := in_range_u8(a ^ b, a & mask, a | mask)
}

sim TestAllExprArgs {
    wire a:    u8 = 0
    wire b:    u8 = 0
    wire mask: u8 = 0
    wire in_band: bool
    AllExprArgs(a, b, mask, in_band)

    // a=60, b=15, mask=15: x=51, lo=12, hi=63 → 51 in [12,63]=true
    poke(a, 60)
    poke(b, 15)
    poke(mask, 15)
    cycle()
    assert(in_band == true, "a=60,b=15,mask=15: x=51 in [12,63] → true")

    // a=60, b=15, mask=254: x=51, lo=60, hi=254 → 51 < lo=60 → false
    poke(mask, 254)
    cycle()
    assert(in_band == false, "a=60,b=15,mask=254: x=51 < lo=60 → false")

    // a=0, b=255, mask=0: x=255, lo=0, hi=0 → 255 > hi=0 → false
    poke(a, 0)
    poke(b, 255)
    poke(mask, 0)
    cycle()
    assert(in_band == false, "a=0,b=255,mask=0: x=255 > hi=0 → false")

    // a=150, b=100, mask=255: x=150^100=242, lo=150, hi=255 → 242 in [150,255]=true
    poke(a, 150)
    poke(b, 100)
    poke(mask, 255)
    cycle()
    assert(in_band == true, "a=150,b=100,mask=255: x=242 in [150,255] → true")
}

// ─── G. Ternary expressions as arguments ─────────────────────────────────────

component TernaryInArgs(in a: u8, in b: u8, in sel: bool, out tsel_bump: u8, out add_max: u8) {
    // Ternary result as the sole argument
    tsel_bump := bump_u8(sel ? a : b)
    // Comparison-based ternary as one of two arguments; plain port as the other
    add_max   := add_u8((a > b) ? a : 0 as u8, b)
}

sim TestTernaryInArgs {
    wire a:   u8   = 0
    wire b:   u8   = 0
    wire sel: bool = false
    wire tsel_bump: u8
    wire add_max:   u8
    TernaryInArgs(a, b, sel, tsel_bump, add_max)

    // sel=true: tsel_bump=bump(a=40)=41; a>b=true→add(40,10)=50
    poke(a, 40)
    poke(b, 10)
    poke(sel, true)
    cycle()
    assert(tsel_bump == 41 as u8, "sel=T: bump(a=40)=41")
    assert(add_max   == 50 as u8, "a>b: add(40,10)=50")

    // sel=false: tsel_bump=bump(b=10)=11; a>b still true
    poke(sel, false)
    cycle()
    assert(tsel_bump == 11 as u8, "sel=F: bump(b=10)=11")
    assert(add_max   == 50 as u8, "a>b: add(40,10)=50")

    // a=5, b=10: sel=false→bump(b=10)=11; 5>10=false→add(0,10)=10
    poke(a, 5)
    poke(b, 10)
    cycle()
    assert(tsel_bump == 11 as u8, "sel=F: bump(b=10)=11")
    assert(add_max   == 10 as u8, "a<b: add(0,10)=10")

    // sel=true, a=5, b=10: bump(a=5)=6; 5>10=false→add(0,10)=10
    poke(sel, true)
    cycle()
    assert(tsel_bump == 6 as u8,  "sel=T: bump(a=5)=6")
    assert(add_max   == 10 as u8, "a<b: add(0,10)=10")
}

// ─── H. Compound expression containing a nested call as argument ──────────────

// The second argument to add_u8 is `bump_u8(a) & mask` — a function call result
// used inside a bitwise expression which is then passed to another function.
// This creates a three-level nesting at the argument site.
component CompoundExprArg(in a: u8, in b: u8, in mask: u8, out result: u8) {
    result := add_u8(a ^ b, (bump_u8(a)) & mask)
}

sim TestCompoundExprArg {
    wire a:    u8 = 0
    wire b:    u8 = 0
    wire mask: u8 = 0
    wire result: u8
    CompoundExprArg(a, b, mask, result)

    // a=60, b=45, mask=240:
    //   first arg:  60^45=17
    //   second arg: bump(60)=61; 61&240=0b00110000=48
    //   add(17,48)=65
    poke(a, 60)
    poke(b, 45)
    poke(mask, 240)
    cycle()
    assert(result == 65 as u8, "add(60^45=17, bump(60)&240=48)=65")

    // a=15, b=240, mask=15:
    //   first arg:  15^240=255
    //   second arg: bump(15)=16; 16&15=0 (no overlap)
    //   add(255,0)=255
    poke(a, 15)
    poke(b, 240)
    poke(mask, 15)
    cycle()
    assert(result == 255 as u8, "add(15^240=255, bump(15)&15=0)=255")

    // a=0, b=0, mask=255:
    //   first arg:  0^0=0
    //   second arg: bump(0)=1; 1&255=1
    //   add(0,1)=1
    poke(a, 0)
    poke(b, 0)
    poke(mask, 255)
    cycle()
    assert(result == 1 as u8, "add(0^0=0, bump(0)&255=1)=1")

    // a=128, b=128, mask=128:
    //   first arg:  128^128=0
    //   second arg: bump(128)=129; 129&128=0b10000001&0b10000000=0b10000000=128
    //   add(0,128)=128
    poke(a, 128)
    poke(b, 128)
    poke(mask, 128)
    cycle()
    assert(result == 128 as u8, "add(128^128=0, bump(128)&128=128)=128")
}
