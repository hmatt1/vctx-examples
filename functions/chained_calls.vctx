// spec: §5.5, §7.3
// expect: pass
// Nested user function calls (each call is inlined at the use site).

function half_u8(x: u8) -> u8 {
    return x >> 1 as u8
}

function bump_twice(x: u8) -> u8 {
    return (half_u8(half_u8(x)) + 3) as u8
}

component ChainedDemo(in x: u8, out y: u8) {
    y := bump_twice(x)
}

sim TestChainedCalls {
    wire x: u8 = 8
    wire y: u8
    ChainedDemo(x, y)
    cycle()
    assert(y == 5 as u8, "half(half(8)) + 3 == 5")
    poke(x, 16 as u8)
    cycle()
    assert(y == 7 as u8, "half(half(16)) + 3 == 7")
    poke(x, 0 as u8)
    cycle()
    assert(y == 3 as u8, "half(half(0)) + 3 == 3")
    poke(x, 4 as u8)
    cycle()
    assert(y == 4 as u8, "half(half(4)) + 3 == 4")
}

sim TestChainedCallsHalfHalf {
    wire x: u8 = 100 as u8
    wire y: u8
    ChainedDemo(x, y)
    cycle()
    assert(y == 28 as u8, "half(half(100)) + 3 == 28")
}

sim TestChainedCallsOdd {
    wire x: u8 = 7 as u8
    wire y: u8
    ChainedDemo(x, y)
    cycle()
    assert(y == 4 as u8, "half(half(7)) truncates: half(7)=3, half(3)=1, +3=4")
    poke(x, 15 as u8)
    cycle()
    assert(y == 6 as u8, "half(half(15)): half(15)=7, half(7)=3, +3=6")
}
