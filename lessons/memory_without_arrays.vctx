// spec: §2
// expect: pass
// Two-byte “RAM” as separate `m0`/`m1` regs + address decode (0xC000 / 0xC001), not `u8[]`.
// Wish / block-RAM phrasing: `top priority checklist.md` → DOCS.

component TwoByteRamRegs(
    in addr: u16,
    in wen: bool,
    in wdata: u8,
    out v0: u8,
    out v1: u8
) {
    reg m0: u8 = 0
    reg m1: u8 = 0
    when wen & (addr == 0xC000) {
        m0 <= wdata
    } elsewhen wen & (addr == 0xC001) {
        m1 <= wdata
    } otherwise {
        m0 <= m0
        m1 <= m1
    }
    v0 := m0
    v1 := m1
}

component TwoByteRamRead(in addr: u16, in v0: u8, in v1: u8, out raw: u8) {
    when addr == 0xC000 {
        raw := v0
    } elsewhen addr == 0xC001 {
        raw := v1
    } otherwise {
        raw := 0 as u8
    }
}

component TwoByteRam(in addr: u16, in wen: bool, in wdata: u8, out raw: u8) {
    wire b0: u8
    wire b1: u8
    TwoByteRamRegs(addr, wen, wdata, b0, b1)
    TwoByteRamRead(addr, b0, b1, raw)
}

// Write to 0xC001, then read it back the same cycle.
sim TwoCellRamWriteM1 {
    wire r: u8
    wire a: u16 = 0xC001
    wire w: bool = true
    wire d: u8 = 0x77 as u8
    TwoByteRam(a, w, d, r)
    cycle()
    assert(r == 0x77 as u8, "write 0x77 at 0xC001, read 0xC001 gives 0x77")
}

// Write to 0xC000 and verify m0 is addressed independently of m1.
sim TwoCellRamWriteM0 {
    wire r: u8
    wire a: u16 = 0xC000
    wire w: bool = true
    wire d: u8 = 0x42 as u8
    TwoByteRam(a, w, d, r)
    cycle()
    assert(r == 0x42 as u8, "write 0x42 at 0xC000, read 0xC000 gives 0x42")
}

// Sequentially write both cells then read each one.
sim TwoCellRamBothCells {
    wire r: u8
    wire a: u16 = 0xC000
    wire w: bool = true
    wire d: u8 = 0xAA as u8
    TwoByteRam(a, w, d, r)
    cycle()
    assert(r == 0xAA as u8, "wrote 0xAA to m0; read-back matches")
    poke(a, 0xC001 as u16)
    poke(d, 0xBB as u8)
    cycle()
    assert(r == 0xBB as u8, "wrote 0xBB to m1; read-back matches")
    poke(a, 0xC000 as u16)
    poke(w, false)
    cycle()
    assert(r == 0xAA as u8, "switch back to m0 without writing: m0 still holds 0xAA")
    poke(a, 0xC001 as u16)
    cycle()
    assert(r == 0xBB as u8, "m1 still holds 0xBB")
}

// An unmapped address returns 0 from TwoByteRamRead.
sim TwoCellRamUnmappedAddress {
    wire r: u8
    wire a: u16 = 0xC000
    wire w: bool = true
    wire d: u8 = 0xFF as u8
    TwoByteRam(a, w, d, r)
    cycle()
    poke(a, 0xDEAD as u16)
    poke(w, false)
    cycle()
    assert(r == 0, "unmapped address 0xDEAD returns 0 from address decoder")
}

// Write-enable=false: register holds its reset value (0).
sim TwoCellRamWriteDisabled {
    wire r: u8
    wire a: u16 = 0xC000
    wire w: bool = false
    wire d: u8 = 0x55 as u8
    TwoByteRam(a, w, d, r)
    cycle()
    assert(r == 0, "wen=0: register starts at reset value 0")
    cycle()
    assert(r == 0, "wen=0: register still holds 0 after second cycle")
}
