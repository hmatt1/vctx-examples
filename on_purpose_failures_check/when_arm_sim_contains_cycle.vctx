// spec: §6.4, §6.8
// expect: fail check [E_ILLEGAL_STATEMENT_IN_WHEN]
// cycle() is illegal inside when arms regardless of context (component or sim).

component Passthru(in x: bool, out y: bool) {
    y := x
}

sim TestCycleInSimWhenArm {
    wire cond: bool = true
    wire x: bool = false
    wire y: bool
    Passthru(x, y)

    when cond {
        cycle()
    }
}
