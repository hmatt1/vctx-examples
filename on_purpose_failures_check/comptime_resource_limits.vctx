// spec: §18
// expect: fail check [E_COMPTIME_REQUIRED]
// Description: Verifies that comptime loop execution iteration limit is enforced.

comptime infinite_loop(n: Int) -> Int {
    let x: Int = 0
    while true {
        x = x + 1
    }
    return x
}

component LoopTop(out y: u[infinite_loop(0)]) {
    y := 0
}
