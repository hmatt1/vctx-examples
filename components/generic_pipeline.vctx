// spec: §10.2, §10.3, §10.4
// expect: pass
// Description: A multi-stage parameterized shift pipeline of arbitrary type and depth.

component GenericPipeline<Type T, Int DEPTH>(in in_data: T, out out_data: T) {
    reg r0: T
    reg r1: T
    reg r2: T
    
    r0 <= in_data
    r1 <= r0
    r2 <= r1
    
    out_data := r2
}

sim TestGenericPipeline {
    wire in_data: u8 = 10
    wire out_data: u8
    
    inst: GenericPipeline<u8, 3>(in_data -- in_data, out_data -- out_data)
    
    reset()
    assert(out_data == 0, "Pipeline should output 0 initially")
    
    poke(in_data, 42)
    cycle() // r0 gets 42
    assert(out_data == 0, "Pipeline output still 0")
    
    poke(in_data, 100)
    cycle() // r0 gets 100, r1 gets 42
    assert(out_data == 0, "Pipeline output still 0")
    
    cycle() // r0 gets 100, r1 gets 100, r2 gets 42
    assert(out_data == 42, "Pipeline output should be 42 after 3 clock edges")
}
