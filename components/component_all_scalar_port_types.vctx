// spec: §5.1 (Components), §8.3 (Scalar types), §11 (Instantiation)
// description: Comprehensive verification that all scalar types are supported as component ports.
// rule: Components must support in/out ports for any valid hardware carrier type.
// expect: pass

component ScalarPassThru(
    in in_bool: bool,   out out_bool: bool,
    in in_u1: u1,       out out_u1: u1,
    in in_u8: u8,       out out_u8: u8,
    in in_u16: u16,     out out_u16: u16,
    in in_u32: u32,     out out_u32: u32,
    in in_u64: u64,     out out_u64: u64,
    in in_s8: s8,       out out_s8: s8,
    in in_s16: s16,     out out_s16: s16,
    in in_s32: s32,     out out_s32: s32,
    in in_s64: s64,     out out_s64: s64,
    in in_u7: u[7],     out out_u7: u[7],
    in in_s5: s[5],     out out_s5: s[5]
) {
    // Structural Passthrough
    out_bool := in_bool
    out_u1 := in_u1
    out_u8 := in_u8
    out_u16 := in_u16
    out_u32 := in_u32
    out_u64 := in_u64
    out_s8 := in_s8
    out_s16 := in_s16
    out_s32 := in_s32
    out_s64 := in_s64
    out_u7 := in_u7
    out_s5 := in_s5
}

sim TestComponentAllScalarPorts {
    // 1. Declare harness wires
    wire w_bool: bool = true
    wire w_u1: u1 = 0
    wire w_u8: u8 = 0xFF
    wire w_u16: u16 = 0xCAFE
    wire w_u32: u32 = 0xDEADBEEF
    wire w_u64: u64 = 0x0123456789ABCDEF
    wire w_s8: s8 = -128
    wire w_s16: s16 = -32768
    wire w_s32: s32 = -2000000000
    wire w_s64: s64 = -9000000000000000000
    wire w_u7: u[7] = 127
    wire w_s5: s[5] = -16

    // Output sinks
    wire out_w_bool: bool
    wire out_w_u1: u1
    wire out_w_u8: u8
    wire out_w_u16: u16
    wire out_w_u32: u32
    wire out_w_u64: u64
    wire out_w_s8: s8
    wire out_w_s16: s16
    wire out_w_s32: s32
    wire out_w_s64: s64
    wire out_w_u7: u[7]
    wire out_w_s5: s[5]

    // 2. Instantiate with named connections (§11)
    ScalarPassThru(
        in_bool -- w_bool, out_bool -- out_w_bool,
        in_u1 -- w_u1, out_u1 -- out_w_u1,
        in_u8 -- w_u8, out_u8 -- out_w_u8,
        in_u16 -- w_u16, out_u16 -- out_w_u16,
        in_u32 -- w_u32, out_u32 -- out_w_u32,
        in_u64 -- w_u64, out_u64 -- out_w_u64,
        in_s8 -- w_s8, out_s8 -- out_w_s8,
        in_s16 -- w_s16, out_s16 -- out_w_s16,
        in_s32 -- w_s32, out_s32 -- out_w_s32,
        in_s64 -- w_s64, out_s64 -- out_w_s64,
        in_u7 -- w_u7, out_u7 -- out_w_u7,
        in_s5 -- w_s5, out_s5 -- out_w_s5
    )

    // 3. Verify Passthrough Correctness
    assert(out_w_bool == true, "bool passthrough")
    assert(out_w_u1 == 0,    "u1 passthrough")
    assert(out_w_u8 == 255,  "u8 passthrough")
    assert(out_w_u16 == 0xCAFE, "u16 passthrough")
    assert(out_w_u32 == 0xDEADBEEF, "u32 passthrough")
    assert(out_w_u64 == 0x0123456789ABCDEF, "u64 passthrough")
    
    assert(out_w_s8 == -128, "val_s8 passthrough")
    assert(out_w_s16 == -32768, "val_s16 passthrough")
    assert(out_w_s32 == -2000000000, "s32 passthrough")
    assert(out_w_s64 == -9000000000000000000, "s64 passthrough")
    
    assert(out_w_u7 == 127, "u7 (non-power2) passthrough")
    assert(out_w_s5 == -16,    "s5 (non-power2) passthrough")

    // 4. Update and Re-verify (Dynamic check)
    poke(w_bool, false)
    poke(w_u1, 1)
    poke(w_s8, 42)
    
    assert(out_w_bool == false, "bool update passthrough")
    assert(out_w_u1 == 1,     "u1 update passthrough")
    assert(out_w_s8 == 42,   "val_s8 update passthrough")

    // 5. Metadata verification on outputs
    assert(width(out_w_u64) == 64, "output u64 width check")
    assert(is_signed(out_w_s64) == true, "output s64 sign check")
    assert(width(out_w_u7) == 7, "output u7 width check")
}
