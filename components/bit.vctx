// spec: §5.1
// expect: pass
component Gate(out y: u8, out b: u7) {
    wire a: u8 = 25
    y := a
    b := (a as u7)
}


sim TestGateOutputs {
    wire a1: u8
    wire b1: u7
    Gate(a1, b1)
    cycle()
    assert(a1 == 25, "full u8 output equals the internal wire value 25")
    assert(b1 == 25 as u7, "u7 cast of 25 is 25 (fits in 7 bits)")
}

sim TestGateCastPreserves {
    wire a1: u8
    wire b1: u7
    Gate(a1, b1)
    cycle()
    assert(a1 == b1 as u8, "25 fits in u7, so cast is lossless: a1 == b1 widened")
}

