// spec: §6.4, §6.7, §7.2, §7.5
// expect: pass
// Description: A cycle-accurate 16-bit CRC checksum generator using the CCITT polynomial 0x1021.

component Crc16Ccitt(
    in data_in: u8,
    in start: bool,
    in next_byte: bool,
    out crc_out: u16,
    out busy: bool
) {
    reg crc: u16 = 0xFFFF as u16
    reg shift_reg: u8 = 0
    reg bit_cnt: u4 = 0
    reg active: bool = false

    wire feedback: bool = crc[15] ^ shift_reg[7]
    wire next_crc: u16 = (crc << 1) as u16
    wire tap_poly: u16 = 0x1021 as u16

    when start {
        crc <= 0xFFFF as u16
        shift_reg <= data_in
        bit_cnt <= 0 as u4
        active <= true
    } elsewhen next_byte & (active == false) {
        shift_reg <= data_in
        bit_cnt <= 0 as u4
        active <= true
    } elsewhen active {
        bit_cnt <= (bit_cnt + 1 as u4) as u4
        shift_reg <= (shift_reg << 1) as u8
        
        when feedback {
            crc <= next_crc ^ tap_poly
        } otherwise {
            crc <= next_crc
        }

        when bit_cnt == 7 as u4 {
            active <= false
        }
    }

    crc_out := crc
    busy := active
}

sim TestCrc16Ccitt {
    wire data_in: u8 = 0x31 // '1' in ASCII
    wire start: bool = false
    wire next_byte: bool = false
    wire crc_out: u16
    wire busy: bool

    inst: Crc16Ccitt(
        data_in -- data_in,
        start -- start,
        next_byte -- next_byte,
        crc_out -- crc_out,
        busy -- busy
    )

    reset()
    assert(crc_out == 0xFFFF as u16, "CRC initially 0xFFFF")
    assert(busy == false, "Generator initially idle")

    // Start with byte 0x31
    poke(start, true)
    cycle()
    poke(start, false)
    assert(busy == true, "Generator busy processing")

    cycle(8)
    assert(busy == false, "Finished after 8 cycles")
    // CRC-16 CCITT of "1" (0x31) is 0xC782 (standard CRC-16/CCITT-FALSE)
    assert(crc_out == 0xC782 as u16, "CRC of 0x31 should be 0xC782")

    // Process next byte 0x32 ('2' in ASCII)
    poke(data_in, 0x32)
    poke(next_byte, true)
    cycle()
    poke(next_byte, false)
    assert(busy == true, "Generator busy on second byte")

    cycle(8)
    assert(busy == false, "Finished second byte")
    // CRC-16 CCITT of "12" (0x31, 0x32) is 0x3DBA (standard CRC-16/CCITT-FALSE)
    assert(crc_out == 0x3DBA as u16, "CRC of 0x31, 0x32 should be 0x3DBA")
}
