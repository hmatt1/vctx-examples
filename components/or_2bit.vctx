// spec: §5.1
// expect: pass
component OrGate1(in a: u2, in b: u2, out y: u2) {
    y := a | b
}

sim TestOrTruthTable {
    wire a: u2 = 0
    wire b: u2 = 0
    wire x: u2
    OrGate1(a, b, x)
    cycle()
    assert(x == 0, "0 | 0 == 0")
    poke(a, 1 as u2)
    cycle()
    assert(x == 1, "1 | 0 == 1")
    poke(a, 0 as u2)
    poke(b, 2 as u2)
    cycle()
    assert(x == 2, "0 | 2 == 2")
    poke(a, 1 as u2)
    poke(b, 2 as u2)
    cycle()
    assert(x == 3, "1 | 2 == 3")
    poke(a, 3 as u2)
    poke(b, 0 as u2)
    cycle()
    assert(x == 3, "3 | 0 == 3: identity with zero")
    poke(a, 3 as u2)
    poke(b, 3 as u2)
    cycle()
    assert(x == 3, "3 | 3 == 3: idempotent")
}

sim TestOrCommutativity {
    wire a: u2 = 1
    wire b: u2 = 2
    wire x: u2
    OrGate1(a, b, x)
    cycle()
    assert(x == 3, "1 | 2 == 3")
    poke(a, 2 as u2)
    poke(b, 1 as u2)
    cycle()
    assert(x == 3, "2 | 1 == 3: OR is commutative")
}

