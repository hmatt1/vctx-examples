// spec: §5.1
// expect: pass check; pass mlir; pass sim
// Inout fan-out: a single bidirectional pin drives two independent output wires.
// ``inout`` behaves like ``in`` on the RHS — it may appear in multiple assignments
// simultaneously.  Both ``copy_a`` and ``copy_b`` carry the value of ``pin`` in the
// same clock cycle.

component Fanout(inout pin: u8, out copy_a: u8, out copy_b: u8) {
    copy_a := pin
    copy_b := pin
}

// Verify that both outputs always mirror the inout pin.
sim TestFanoutInitial {
    wire pin: u8 = 0xAB
    wire ca: u8
    wire cb: u8
    Fanout(pin, ca, cb)
    cycle()
    assert(ca == 0xAB as u8, "initial: copy_a mirrors pin 0xAB")
    assert(cb == 0xAB as u8, "initial: copy_b mirrors pin 0xAB")
}

// Verify fan-out tracks every poke of the inout pin.
sim TestFanoutPoke {
    wire pin: u8 = 0
    wire ca: u8
    wire cb: u8
    Fanout(pin, ca, cb)
    cycle()
    assert(ca == 0, "start: both outputs are zero")
    assert(cb == 0, "start: both outputs are zero")
    poke(pin, 0xFF)
    cycle()
    assert(ca == 0xFF as u8, "after poke 0xFF: copy_a updated")
    assert(cb == 0xFF as u8, "after poke 0xFF: copy_b updated")
    poke(pin, 0x42 as u8)
    cycle()
    assert(ca == 0x42 as u8, "after poke 0x42: fan-out tracks every change")
    assert(cb == 0x42 as u8, "after poke 0x42: both copies always agree")
}

// Verify that two copies stay independent: asserting one does not affect the other.
sim TestFanoutBothEqual {
    wire pin: u8 = 0x0F
    wire ca: u8
    wire cb: u8
    Fanout(pin, ca, cb)
    cycle()
    assert(ca == cb, "copies are always equal to each other")
    poke(pin, 0xF0 as u8)
    cycle()
    assert(ca == cb, "equality preserved after poke")
}
