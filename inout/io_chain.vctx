// spec: §5.1
// expect: pass check; pass mlir
// Inout chain: the parent receives ``pin`` as an inout port and forwards it to an
// inner component via named port binding (``pin -- pin``).  The MLIR emitter threads
// the parent's ``!hw.inout<i8>`` block argument through ``inout_raw`` so no
// intermediate sv.wire is inserted — the same reference propagates down the hierarchy.
//
// This pattern models a structural hierarchy where a bidirectional pad ripples through
// several levels without being converted to a value until the leaf reads it.

component InnerLeaf(inout pin: u8, out q: u8) {
    q := pin
}

component Chain(inout pin: u8, out q: u8) {
    leaf: InnerLeaf(pin -- pin, q -- q)
}
